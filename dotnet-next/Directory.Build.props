<Project><PropertyGroup><BaseOutputPath Condition="'$(WorkspaceBuildRoot)' != ''">$(WorkspaceBuildRoot)/$(MSBuildProjectName)/</BaseOutputPath><TargetFramework Condition="'$(ModularProductBuild)' != 'true'">net9.0</TargetFramework><TargetFramework Condition="'$(ModularProductBuild)' == 'true'">net10.0</TargetFramework><Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic><Version Condition="'$(ModularProductBuild)' != 'true'">0.1.0</Version><Version Condition="'$(ModularProductBuild)' == 'true'">1.0.3</Version></PropertyGroup></Project>
