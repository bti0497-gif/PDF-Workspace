<UserControl x:Class="Workspace.Shell.Presentation.HomeView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Center">
  <Grid MinHeight="240" VerticalAlignment="Stretch"><StackPanel x:Name="HomeContent" MaxWidth="520" Margin="32" HorizontalAlignment="Center" VerticalAlignment="Center">
   <Border Width="58" Height="70" BorderBrush="#8B9DB2" BorderThickness="2" CornerRadius="5" Margin="0,0,0,24"><TextBlock Text="PDF" FontSize="16" FontWeight="SemiBold" Foreground="#58738E" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
   <TextBlock Text="더존 PDF" FontSize="28" FontWeight="SemiBold" TextAlignment="Center" Foreground="#20334A"/>
   <TextBlock Text="익숙한 작업 공간, 필요한 기능만." Margin="0,14,0,0" FontSize="16" TextAlignment="Center" Foreground="#53667C"/>
   <TextBlock Text="현재는 작업 화면을 만드는 단계입니다. PDF 열기·편집·저장은 아직 연결하지 않았습니다." TextWrapping="Wrap" TextAlignment="Center" Margin="0,22,0,24" Foreground="#68788B"/>
   <Button x:Name="SampleOpenButton" Content="샘플 문서로 조작해 보기" Command="{Binding OpenPreview}" HorizontalAlignment="Center" Padding="22,11" ToolTip="Ctrl+O · 내장 샘플 2개로 UI만 검토합니다"/>
   <TextBlock Text="실제 파일을 열거나 저장하지 않습니다.&#x0a;단축키와 조작 방법: 도움말 → 조작 안내" TextWrapping="Wrap" TextAlignment="Center" Margin="0,14,0,0" FontSize="12" Foreground="#68788B"/>
   <TextBlock Text="기존 앱과 사용자 문서는 변경하지 않습니다." TextWrapping="Wrap" TextAlignment="Center" Margin="0,24,0,0" FontSize="12" Foreground="#7A8797"/>
  </StackPanel></Grid>
 </ScrollViewer>
</UserControl>
