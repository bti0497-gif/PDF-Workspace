<Window x:Class="Workspace.Shell.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="더죤 PDF Workspace" Icon="pack://application:,,,/Workspace.App;component/Assets/deojon-pdf-workspace.ico" Width="1280" Height="820" MinWidth="640" MinHeight="480" WindowState="Maximized" FontFamily="Malgun Gothic" FontSize="12" Background="#F1F2F4"> <Window.Resources>
  <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
  <Style TargetType="Button"><Setter Property="Padding" Value="10,5"/><Setter Property="Margin" Value="2"/><Setter Property="MinHeight" Value="27"/><Setter Property="Background" Value="#FAFAFA"/><Setter Property="BorderBrush" Value="#C9CDD2"/><Setter Property="Foreground" Value="#30343A"/><Setter Property="Cursor" Value="Hand"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/></Style>
  <Style x:Key="TabButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="55"/><Setter Property="Padding" Value="12,5"/><Setter Property="Margin" Value="0"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="TabChrome" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#D87956"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabChrome" Property="Background" Value="#D87956"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="QuickButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="MinWidth" Value="30"/><Setter Property="MinHeight" Value="24"/><Setter Property="Padding" Value="6,2"/><Setter Property="Margin" Value="1,0"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="6"/><Setter Property="Margin" Value="2,3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Background" Value="Transparent"/></Style>
  <Style x:Key="MutedText" TargetType="TextBlock"><Setter Property="Foreground" Value="#69747D"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="GroupBorder" TargetType="Border"><Setter Property="BorderBrush" Value="#D1D3D7"/><Setter Property="BorderThickness" Value="0,0,1,0"/><Setter Property="Margin" Value="0,0,7,4"/><Setter Property="Padding" Value="6,0,12,0"/></Style>
  <Style x:Key="GroupCaption" TargetType="TextBlock"><Setter Property="TextAlignment" Value="Center"/><Setter Property="Foreground" Value="#6A6D72"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,5,0,0"/></Style>
  <Style x:Key="RibbonIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="78"/><Setter Property="Height" Value="70"/><Setter Property="Padding" Value="4"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="RibbonIconChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RibbonIconChrome" Property="Background" Value="#E7EDF2"/><Setter TargetName="RibbonIconChrome" Property="BorderBrush" Value="#A6B4C1"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="RibbonIconChrome" Property="Background" Value="#D8E1E8"/><Setter TargetName="RibbonIconChrome" Property="BorderBrush" Value="#8093A3"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RibbonIconChrome" Property="Background" Value="#EDF3F7"/><Setter TargetName="RibbonIconChrome" Property="BorderBrush" Value="#3E6F93"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.58"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SpecialRibbonIconButton" TargetType="Button" BasedOn="{StaticResource RibbonIconButton}"><Setter Property="Width" Value="88"/></Style>
  <Style x:Key="HeaderIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="28"/><Setter Property="MinHeight" Value="28"/><Setter Property="Margin" Value="1,0"/><Setter Property="Padding" Value="6"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="ToolTipService.ShowOnDisabled" Value="True"/><Setter Property="ToolTipService.InitialShowDelay" Value="350"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="IconChrome" Background="{TemplateBinding Background}" BorderBrush="Transparent" BorderThickness="1" CornerRadius="3" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="IconChrome" Property="Background" Value="#26FFFFFF"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="IconChrome" Property="Background" Value="#44FFFFFF"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="IconChrome" Property="BorderBrush" Value="White"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources><Grid x:Name="ShellRoot" Background="#F1F2F4">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border Grid.Row="1" Background="#C45C38" Padding="5,0"><DockPanel>
<Button DockPanel.Dock="Right" x:Name="RibbonToggle" Style="{StaticResource HeaderIconButton}" AutomationProperties.Name="리본 접기/펼치기" ToolTip="리본 접기/펼치기 (Ctrl+F1)"><Path Data="M2,9 L8,3 14,9" Width="14" Height="12" Stretch="Uniform" Stroke="White" StrokeThickness="1.8"/></Button>
<WrapPanel x:Name="TopTabs"><Button Content="파일" Style="{StaticResource TabButton}"/><Button Content="홈" Style="{StaticResource TabButton}"/><Button Content="기본" Style="{StaticResource TabButton}"/><Button Content="주석" Style="{StaticResource TabButton}"/><Button Content="문서" Style="{StaticResource TabButton}"/><Button Content="보기" Style="{StaticResource TabButton}"/><Button Content="도움말" Style="{StaticResource TabButton}"/></WrapPanel>
</DockPanel></Border>
<Border Grid.Row="2" x:Name="RibbonPanel" Background="#F6F6F6" BorderBrush="#C9CDD2" BorderThickness="0,0,0,1"><ScrollViewer x:Name="RibbonScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MaxHeight="174" Padding="6,7,6,5"/></Border>
<Border Grid.Row="6" x:Name="StatusBar" BorderBrush="#D5D8DC" BorderThickness="0,1,0,0" Background="#F9F9F9" Padding="8,5"><DockPanel><TextBlock x:Name="ProductVersionText" DockPanel.Dock="Right" Text="1.0.2" FontSize="11" Foreground="#83878C" Margin="14,0,0,0"/><TextBlock x:Name="StatusText" Foreground="#616973" TextWrapping="Wrap" FontSize="11" MaxHeight="42"/></DockPanel></Border>
</Grid></Window>

